# Local application settings. Copy this file to .env and replace the SMTP values.
HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=0
APP_ENV=development

# FastAPI storage. The default runs locally without extra services.
DATABASE_URL=sqlite:///./backend/data/hh_platform.sqlite3
SQL_ECHO=0

# Optional PostgreSQL container (`docker compose up -d postgres`).
# Set POSTGRES_PASSWORD in your local .env, then change DATABASE_URL to:
# postgresql://hh_platform:<POSTGRES_PASSWORD>@127.0.0.1:5432/hh_platform
POSTGRES_DB=hh_platform
POSTGRES_USER=hh_platform
POSTGRES_PORT=5432
# POSTGRES_PASSWORD=

# Mail server used to send registration confirmation codes.
# SMTP_TLS: starttls for port 587, implicit for port 465, none only for a trusted local relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
# Example: SMTP_FROM="predel <no-reply@example.com>"
SMTP_FROM=

# Authentication lifetime settings.
AUTH_CODE_TTL_MINUTES=10
AUTH_SESSION_DAYS=30
# Optional total SMTP timeout in milliseconds.
SMTP_TIMEOUT_MS=15000

# LLM via OpenRouter: assistants, question generation and independent verification.
# Without a key the platform works fully: assistants answer with built-in scenarios
# and the test uses the authored bank plus already generated items.
# Only open-weight models are accepted (qwen/* Apache-2.0, deepseek/* MIT).
OPENROUTER_API_KEY=
# Cheapest instruct model for both assistants and the item generator.
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Automatic fallback if the primary model is unavailable; leave empty to disable.
OPENROUTER_FALLBACK_MODEL=qwen/qwen3-32b
# Independent solver that must answer a generated item correctly before piloting.
OPENROUTER_VERIFIER_MODEL=deepseek/deepseek-v3.2
# Background top-up of the dynamic bank (1 = on). Requires the key above.
ITEM_BANK_AUTOGEN=1
# Optional authoring preview for open assessments (not used by the live test).
OPENROUTER_ASSESSMENT_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# External evidence integrations in the PRIMARY Node.js backend.
# Demo FSP is disabled automatically when APP_ENV or NODE_ENV is production.
INTEGRATION_DEMO=1
# Refresh registered public result pages daily; retry failed sources hourly.
PUBLIC_SOURCE_AUTOSYNC=1
# Official Codeforces API. No OAuth client or user password is required.
CODEFORCES_ENABLED=1
ATCODER_ENABLED=1
KAGGLE_ENABLED=1
# GitHub OAuth App, public profile/repositories only. Register your own app.
GITHUB_ENABLED=1
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:5173/api/integrations/github/callback
# AES-256-GCM key: 64 hexadecimal characters. Set for every live integration.
# INTEGRATION_ENCRYPTION_KEY=
# Proposed FSP resource contract: docs/api/fsp-provider.openapi.json.
# Enable only after agreeing the real API contract and obtaining credentials.
FSP_OIDC_ISSUER=
FSP_CLIENT_ID=
FSP_CLIENT_SECRET=
FSP_API_BASE_URL=
# Must point to the public same-origin /api/integrations/fsp/callback.
# Example for Vite development: http://127.0.0.1:5173/api/integrations/fsp/callback
FSP_REDIRECT_URI=
# Optional partner webhook signing secret; configure the same value with FSP.
FSP_WEBHOOK_SECRET=
