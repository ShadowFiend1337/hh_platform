{
  "name": "predel-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "prepare:resume": "node scripts/prepare-resume-assets.mjs",
    "postinstall": "npm run prepare:resume",
    "predev": "npm run prepare:resume",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:resume",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/smoke.mjs",
    "test:assessment": "node tests/assessment.mjs",
    "test:resume": "node tests/resume.mjs",
    "test:resume-parser": "node --test tests/resume-parser.test.mjs tests/catalog.test.mjs tests/grading.test.mjs",
    "test:directions": "node tests/directions.mjs",
    "test:grades": "node tests/grades.mjs",
    "test:search": "node tests/search.mjs",
    "test:swipe": "node tests/swipe.mjs",
    "test:offers": "node tests/vacancy-deck.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "motion": "13.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
