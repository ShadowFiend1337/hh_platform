    "test:codeforces-browser": "node frontend/tests/codeforces.mjs",
    "test:external-providers-browser": "node frontend/tests/external-providers.mjs",
    "import:public-achievements": "node --use-env-proxy scripts/import-public-achievements.mjs",
    "test:public-achievements-browser": "node frontend/tests/public-achievements.mjs",
    "test:access": "node frontend/tests/access-gate.mjs",
    "test:demo-catalog": "node frontend/tests/demo-catalog.mjs",
    "test:hiring-needs": "node frontend/tests/hiring-needs.mjs",
    "test:tasks": "node frontend/tests/tasks.mjs",
    "test:favorites": "node frontend/tests/favorites.mjs",
    "test:open-assessment": "node --test server/tests/open-assessment.test.mjs && node frontend/tests/open-assessment.mjs",
    "test:browser:all": "node scripts/browser-tests.mjs",
    "test:item-bank-ui": "node frontend/tests/item-bank-moderation.mjs",
    "docs:openapi": "node scripts/openapi.mjs",
    "measure:modes": "node frontend/tests/mode-focus.mjs",
    "charts": "node scripts/charts.mjs",
    "test:fsp": "node frontend/tests/fsp-link.mjs",
    "test:unconfirmed": "node frontend/tests/unconfirmed-directory.mjs",
    "test:assessment-guard": "node frontend/tests/assessment-guard.mjs",
    "test:code-editor": "node frontend/tests/code-editor.mjs",
    "test:open-bank": "node --test server/tests/open-bank.test.mjs",
    "test:review-bank": "node --test server/tests/review-bank.test.mjs server/tests/closed-review-bank.test.mjs server/tests/review-bank-store.test.mjs",
    "validate:closed-review-bank": "node scripts/closed-review-bank.mjs validate",
    "report:closed-review-bank": "node scripts/closed-review-bank.mjs report",
    "import:review-bank": "node scripts/closed-review-bank.mjs import",
    "stats:review-bank": "node scripts/closed-review-bank.mjs stats",
    "validate:review-bank": "node scripts/review-bank.mjs validate",
    "report:review-bank": "node scripts/review-bank.mjs report",
    "sample:review-bank": "node scripts/review-bank.mjs sample",
