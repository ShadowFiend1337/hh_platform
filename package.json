    "test:profile-privacy": "node frontend/tests/profile-privacy.mjs",
    "test:soft-skills": "node frontend/tests/soft-skills.mjs",
    "test:profile-pdf": "node frontend/tests/profile-pdf.mjs",
    "validate:open-bank": "node scripts/open-bank.mjs validate",
    "sample:open-bank": "node scripts/open-bank.mjs sample",
    "export:open-bank": "node scripts/open-bank.mjs export",
    "test:registration-privacy": "node frontend/tests/registration-privacy.mjs",
    "tour:screens": "node frontend/tests/visual-tour.mjs"
  },
  "dependencies": {
    "parse5": "8.0.0"
  }
}
