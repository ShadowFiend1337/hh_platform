{
  "name": "predel",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/server.mjs",
    "build": "npm --prefix frontend run build",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:browser": "npm --prefix frontend run test:browser",
    "test:assessment": "npm --prefix frontend run test:assessment",
    "test:resume": "npm --prefix frontend run test:resume",
    "test:directions": "npm --prefix frontend run test:directions",
    "test:grades": "npm --prefix frontend run test:grades",
    "test:search": "npm --prefix frontend run test:search",
    "setup:search": "node scripts/ml.mjs setup",
    "train:search": "node scripts/ml.mjs train",
    "evaluate:search": "node scripts/ml.mjs evaluate",
    "check:search-model": "node scripts/ml.mjs check",
    "validate:assessment": "node server/validate.mjs"
  }
}
