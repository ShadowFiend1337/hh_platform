{
  "name": "predel",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fastapi": "node scripts/dev.mjs --fastapi",
    "start": "node server/server.mjs",
    "start:fastapi": "node scripts/start-backend.mjs",
    "export:fastapi-data": "node scripts/export-fastapi-data.mjs",
    "build": "npm --prefix frontend run build",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:auth": "node frontend/tests/auth.mjs",
    "test:browser": "npm --prefix frontend run test:browser",
    "test:assessment": "npm --prefix frontend run test:assessment",
    "test:resume": "npm --prefix frontend run test:resume",
    "test:directions": "npm --prefix frontend run test:directions",
    "test:grades": "npm --prefix frontend run test:grades",
    "test:search": "npm --prefix frontend run test:search",
    "test:swipe": "npm --prefix frontend run test:swipe",
    "test:offers": "npm --prefix frontend run test:offers",
    "test:companies": "node scripts/browser-companies.mjs",
    "test:soft-skills": "node frontend/tests/soft-skills.mjs",
    "test:profile-pdf": "node frontend/tests/profile-pdf.mjs",
    "setup:local-accounts": "node scripts/local-accounts.mjs",
    "setup:search": "node scripts/ml.mjs setup",
    "train:search": "node scripts/ml.mjs train",
    "prepare:search-ranker": "node scripts/ml.mjs prepare",
    "calibrate:search-score": "node scripts/ml.mjs calibrate",
    "prepare:search-policy": "node scripts/ml.mjs admit",
    "evaluate:search": "node scripts/ml.mjs evaluate",
    "check:search-model": "node scripts/ml.mjs check",
    "activate:search-model": "node scripts/ml.mjs activate",
    "test:search-quality": "node ml/search-regression.mjs --run --strict",
    "validate:assessment": "node server/validate.mjs"
  }
}
